{
	"name": "tailwindcss-fluid-workspace",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.13.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "pnpm -r --filter=./packages/* build",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "pnpm -r --filter=./packages/* test"
	},
	"devDependencies": {
		"@eslint/js": "^9.19.0",
		"eslint": "^9.19.0",
		"prettier": "^3.4.2",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.23.0"
	}
}
